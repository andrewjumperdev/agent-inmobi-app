# ── Variables de entorno del frontend ──────────────────────────────────
# Local:      copiá a `.env.local` y completá.
# Producción: cargalas en Vercel → Settings → Environment Variables.
#
# Regla: solo lo que lleva NEXT_PUBLIC_ llega al navegador. Todo lo demás vive
# únicamente en el servidor (Server Components y route handlers). No le pongas
# el prefijo a un secreto: quedaría embebido en el bundle del cliente.

# ── Supabase (auth + perfiles) ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Secreta. Se usa para leer/escribir profiles.kore_api_key, que la migración
# 0003 le esconde al rol del cliente.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ── Backend KORE (FastAPI) ─────────────────────────────────────────────
# Sin NEXT_PUBLIC_ a propósito: solo el BFF habla con el backend.
KORE_BACKEND_URL=https://api.tudominio.com/api/v1
KORE_DEFAULT_NICHE=real-estate

# Autoriza el alta de tenants (POST /tenants). Tiene que ser EL MISMO valor que
# KORE_PROVISIONING_SECRET en el .env del backend. Si no coincide, el onboarding
# falla al provisionar con un 401.
#   openssl rand -hex 32
KORE_PROVISIONING_SECRET=

# ── Clasificador de leads (/api/classify-lead) ─────────────────────────
# mock (default, sin costo) | groq | anthropic
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# ── Stripe (opcional, si cobrás desde el frontend) ─────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
